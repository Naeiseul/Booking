{
  "rewrites": [
    {
      "source": "/start",
      "destination": "/checkout.html"
    },
    {
      "source": "/order",
      "destination": "/sales-invoice.html"
    },
    {
      "source": "/admin/:biz/:key",
      "destination": "/admin.html"
    },
    {
      "source": "/:biz/details",
      "destination": "/details.html"
    },
    {
      "source": "/:biz",
      "destination": "/index.html"
    }
  ],
  "images": {
    "sizes": [
      96,
      192,
      384,
      640,
      960,
      1600
    ],
    "domains": [],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "^jtonmfevmcmnkmdjmubn\\.supabase\\.co$",
        "port": "",
        "pathname": "^/storage/v1/object/public/service-photos/[a-zA-Z0-9/_-]+\\.(png|jpg|jpeg|webp)$",
        "search": ""
      }
    ],
    "localPatterns": [
      {
        "pathname": "^/(final_tax_logo|logo_square|phone)\\.png$",
        "search": ""
      }
    ],
    "qualities": [
      75
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 604800
  },
  "headers": [
    {
      "source": "/:asset(finance-login|admin-payments|customer-invoice|finance|photo-tools|business-profile|admin-profile|admin-navigation|admin-services|admin-slot-time|admin-contacts|admin|app|styles|catalogue|profile)\\.:ext(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[0-9]+"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/invoice.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/finance-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/order",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
